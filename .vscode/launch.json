{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "debugpy",
      "request": "attach",
      "name": "Attach to Remote Debugpy",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}", // Local path to your workspace
          "remoteRoot": "/root/deployment/source" // Remote path where the app is deployed
        }
      ],
    }
  ]
}